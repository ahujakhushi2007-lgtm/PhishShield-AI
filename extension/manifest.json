{
  "manifest_version": 3,
  "name": "PhishShield AI — Scam & Phishing Radar",
  "version": "1.0.0",
  "description": "Right-click AI threat analysis for URLs, SMS, and suspicious messages with instant verdict and risk score.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:5001/*",
    "http://localhost:5000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PhishShield AI Scanner"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
